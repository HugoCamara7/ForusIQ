# =============================================================================
# Forusight - secrets
# =============================================================================
# Lo más simple: pega los secrets de Catálogo Control Center y agrega las líneas
# marcadas como NUEVO. Se usan los bloques de login, BigQuery, la cuenta de
# servicio y (opcional) ticketing; el resto (shopify_sites, ...) se ignora.
#
# Copia como .streamlit/secrets.toml (en .gitignore: NUNCA lo subas) o pégalo en
# Streamlit Cloud > App settings > Secrets.
# =============================================================================

[bigquery]
enabled = true
project_id = "PROYECTO_DONDE_SE_EJECUTA_EL_JOB"
# ARTI (maestro de productos): la clave `table` del Catálogo.
table = "forus-analitica-prod-datalake.bronze.stg_pe_central_arti"
# En el Catálogo suele ser la tabla de EAN: Forusight la descarta sola si no sirve.
product_master_table = "forus-analitica-prod-datalake.bronze.stg_pe_central_cean"
stock_table = "forus-analitica-prod-datalake.bronze.stg_pe_central_stock_bi"

# NUEVO - venta real: OBLIGATORIA (el stock sólo trae el último corte).
ventas_table = "proyecto.dataset.tabla_de_ventas"

# NUEVO - maestros (opcionales, recomendados):
maestro_tiendas_table = "proyecto.dataset.maestro_tiendas"   # código tienda -> nombre tienda
maestro_cadena_table = "proyecto.dataset.maestro_cadena"     # código modelo -> cadena

# Opcionales:
# location = "US"   # si falta, BigQuery la infiere
# max_gb = 20       # tope por consulta (dry run)

[app_auth.users]
"nombre.apellido@forus.pe" = "CAMBIAR_ESTA_CLAVE"
# Sin [app_auth.roles] todos son administradores, igual que en Catálogo.

[gcp_service_account]
type = "service_account"
project_id = "TU_PROJECT_ID"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "tu-service-account@tu-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

[forusight]
marcas = ["HUSH PUPPIES"]   # marca por defecto en el selector (valor de MARCA_MA)
tiendas_excluidas = []      # códigos que nunca reciben (bodegas eComm, outlets)
cd_id = "320"

# -----------------------------------------------------------------------------
# Dónde guardar las aprobaciones (no hace falta dataset de BigQuery)
# -----------------------------------------------------------------------------
# Pega el MISMO bloque [ticketing] de Catálogo Control Center: Forusight escribe
# en la carpeta forusight/ de esa rama. Sin él, la aprobación se descarga.
# [ticketing]
# backend = "github"
# repository = "ORGANIZACION/REPOSITORIO"
# token = "GITHUB_TOKEN_CON_PERMISO_CONTENTS_READ_WRITE"
# branch = "catalog-tickets"
