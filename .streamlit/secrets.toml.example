# =============================================================================
# Forusight - secrets
# =============================================================================
# Copia este archivo como .streamlit/secrets.toml (está en .gitignore: NUNCA lo
# subas) o pégalo en Streamlit Cloud > App settings > Secrets.
#
# Es el MISMO esquema que Catálogo Control Center y Repo Control Center: puedes
# pegar tus bloques [app_auth], [bigquery] y [gcp_service_account] tal cual.
# Las claves que esta app no usa (shopify_sites, ticketing, ...) se ignoran.
# =============================================================================


# -----------------------------------------------------------------------------
# LOGIN (obligatorio para usar BigQuery; sin él sólo se entra en modo demo)
# -----------------------------------------------------------------------------
[app_auth]
# Opción A - un solo usuario (queda como administrador):
# username = "admin"
# password = "CAMBIAR_ESTA_CLAVE"

# Opción B - varios usuarios (recomendado). Reemplaza a la opción A.
[app_auth.users]
"nombre.apellido@forus.pe" = "CAMBIAR_ESTA_CLAVE"
"otra.persona@forus.pe" = "CAMBIAR_ESTA_CLAVE"

# Roles: admin (todo, incluida Conexión y guardar parámetros) | aprobador
# (confirma distribuciones) | analista (ejecuta y revisa). Sin rol = analista.
[app_auth.roles]
"nombre.apellido@forus.pe" = "admin"
"otra.persona@forus.pe" = "aprobador"


# -----------------------------------------------------------------------------
# FORUSIGHT
# -----------------------------------------------------------------------------
[forusight]
data_source = "bigquery"        # "bigquery" (tablas Forus) | "synthetic" (demo)
cd_id = "320"
marcas = ["AZALEIA"]            # valor de la marca en ARTI (MARCA_MA), en mayúsculas
tiendas_excluidas = []          # códigos que nunca reciben: bodegas eComm, outlets…
dataset_app = "forusight_app"   # dataset donde se guardan corridas y aprobaciones
cache_ttl_seconds = 3600


# -----------------------------------------------------------------------------
# BIGQUERY (mismo bloque que Catálogo / Repo Control Center)
# -----------------------------------------------------------------------------
[bigquery]
enabled = true
project_id = "forus-analitica-prod-datalake"
# Si la cuenta no puede crear jobs en el datalake, un proyecto donde tenga
# roles/bigquery.jobUser (ahí se factura):
job_project_id = "PROYECTO_DONDE_SE_EJECUTA_EL_JOB"
# location = "US"
max_gb = 20                     # tope por consulta; se verifica con dry run

# Rutas completas proyecto.dataset.tabla. Sin valores por defecto en el código.
ventas_table = "PROY.DATASET.TABLA_DE_VENTAS"
product_master_table = "forus-analitica-prod-datalake.bronze.stg_pe_central_arti"
stock_table = "forus-analitica-prod-datalake.bronze.stg_pe_central_stock_bi"

# Mapeo de columnas (opcional). La app lo descubre sola; la página Conexión
# genera estos bloques para fijarlo. Van DESPUÉS de [bigquery], ejemplo:
# [bigquery.mapeo.stock]
# fecha = "fecha_corte"
# tienda_cod = "codigo_tienda"
# id_producto = "id_producto"
# stock_tienda = "stock_tiendas"
# stock_bodega = "stock_bodega"


# -----------------------------------------------------------------------------
# CUENTA DE SERVICIO (mínimo privilegio)
#   - roles/bigquery.jobUser en el proyecto de los jobs
#   - roles/bigquery.dataViewer sobre los datasets de las tablas fuente
#   - roles/bigquery.dataEditor SOLO sobre el dataset de [forusight] dataset_app
# private_key en UNA línea, entre comillas dobles, con los saltos como \n.
# -----------------------------------------------------------------------------
[gcp_service_account]
type = "service_account"
project_id = "TU_PROJECT_ID"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "tu-service-account@tu-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
