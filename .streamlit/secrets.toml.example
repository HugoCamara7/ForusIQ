# =============================================================================
# Forusight - secrets
# =============================================================================
# Lo más simple: PEGA TAL CUAL los secrets de Catálogo Control Center.
# Esta app usa sus bloques [app_auth], [bigquery] y [gcp_service_account];
# el resto (shopify_sites, ticketing, ...) se ignora sin error.
#
# No hace falta configurar tablas:
#   - ARTI  = la tabla `table` / `product_master_table` del Catálogo
#             (por defecto forus-analitica-prod-datalake.bronze.stg_pe_central_arti)
#   - Stock = forus-analitica-prod-datalake.bronze.stg_pe_central_stock_bi
#   - Venta = opcional. Sin `ventas_table` se estima por consumo de stock.
#
# Copia como .streamlit/secrets.toml (en .gitignore: NUNCA lo subas) o pégalo en
# Streamlit Cloud > App settings > Secrets.
# =============================================================================

[bigquery]
enabled = true
project_id = "PROYECTO_DONDE_SE_EJECUTA_EL_JOB"
job_project_id = "PROYECTO_DONDE_SE_EJECUTA_EL_JOB"
table = "forus-analitica-prod-datalake.bronze.stg_pe_central_arti"
product_master_table = "forus-analitica-prod-datalake.bronze.stg_pe_central_arti"

# Opcionales (van DENTRO de [bigquery], sin repetir el encabezado):
# stock_table = "forus-analitica-prod-datalake.bronze.stg_pe_central_stock_bi"
# ventas_table = "proyecto.dataset.tabla"   # la página Conexión busca candidatas
# location = "US"                           # si falta, BigQuery la infiere
# max_gb = 20                               # tope por consulta (dry run)

[app_auth]
# Un solo usuario (queda como administrador)...
username = "admin"
password = "CAMBIAR_ESTA_CLAVE"

# ...o varios. Sin [app_auth.roles] todos son administradores, igual que en Catálogo.
# [app_auth.users]
# "hugo.camara@forus.pe" = "CAMBIAR_ESTA_CLAVE"
# "luis.nunez@forus.pe" = "CAMBIAR_ESTA_CLAVE"

# Roles opcionales: admin | aprobador (o "operator") | analista (o "brand").
# Si esta sección existe, quien no esté listado queda como analista.
# [app_auth.roles]
# "luis.nunez@forus.pe" = "aprobador"

[gcp_service_account]
type = "service_account"
project_id = "TU_PROJECT_ID"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "tu-service-account@tu-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# -----------------------------------------------------------------------------
# Opcional: ajustes propios de Forusight (todos tienen valor por defecto)
# -----------------------------------------------------------------------------
# [forusight]
# marcas = ["AZALEIA"]            # marca por defecto en el selector (MARCA_MA)
# tiendas_excluidas = []          # códigos que nunca reciben (bodegas eComm, outlets)
# cd_id = "320"
