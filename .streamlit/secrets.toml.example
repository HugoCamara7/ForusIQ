# Copiar a .streamlit/secrets.toml (está en .gitignore) y completar.
# NUNCA subir este archivo con valores reales.

[forusight]
data_source = "bigquery"          # "bigquery" | "synthetic"
gcp_project = "TU-PROYECTO-GCP"   # proyecto que factura las consultas
bq_location = "US"
dataset_mart = "forusight_mart"
dataset_app = "forusight_app"
cd_id = "320"
cache_ttl_seconds = 3600

# Cuenta de servicio con mínimo privilegio:
#   - roles/bigquery.jobUser en el proyecto de ejecución
#   - roles/bigquery.dataViewer en el dataset MART
#   - roles/bigquery.dataEditor SOLO en el dataset APP
[gcp_service_account]
type = "service_account"
project_id = "TU-PROYECTO-GCP"
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "forusight-app@TU-PROYECTO-GCP.iam.gserviceaccount.com"
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
